{"nodes": [{"id": "docs_d8_journal_decisions", "label": "D8 \u2014 Journal des d\u00e9cisions", "file_type": "document", "source_file": "docs/D8-journal-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_d8_journal_decisions_conventions", "label": "Conventions du journal (une ligne par d\u00e9cision, jamais effac\u00e9e)", "file_type": "concept", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_d8_journal_decisions_n36", "label": "n\u00b0 36 : P0 arbitrage : 5 \u00e0 10 visages, aucun faux positif en N", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Une seule erreur visible d\u00e9truit la confiance"}, {"id": "docs_d8_journal_decisions_n37", "label": "n\u00b0 37 : P0 performance : \u2265 10 img/s sans chauffe en 5 min", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_d8_journal_decisions_n64", "label": "n\u00b0 64 : calibrage en deux temps, seuil propre k = 0,5", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un seuil fixe est injuste : l'amplitude mesur\u00e9e varie selon le visage"}, {"id": "docs_d8_journal_decisions_n65", "label": "n\u00b0 65 : perte continue > 5 s = faute", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sans cela, un joueur \u00e9chappe au jugement en sortant du champ"}, {"id": "docs_d8_journal_decisions_n66", "label": "n\u00b0 66 : W = max(200 ms, 2 \u00d7 erreur estim\u00e9e)", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La latence r\u00e9seau est du m\u00eame ordre que 200 ms"}, {"id": "docs_d8_journal_decisions_n67", "label": "n\u00b0 67 : deux visages = image invalide", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plus simple, et emp\u00eache de se faire remplacer"}, {"id": "docs_d8_journal_decisions_n68", "label": "n\u00b0 68 : pics \u00e9gaux \u00e0 moins de 0,05 = manche nulle", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un \u00e9cart infime ne d\u00e9partage pas honn\u00eatement"}, {"id": "docs_d8_journal_decisions_n69", "label": "n\u00b0 69 : aucun enregistrement = aucun stockage persistant ; image de preuve transmise", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Image nette et exacte sans rien stocker"}, {"id": "docs_d8_journal_decisions_n70", "label": "n\u00b0 70 : main devant la bouche accept\u00e9e en v1, Hand Landmarker en dette", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Co\u00fbt en performance ; entre amis l'adversaire voit la main"}, {"id": "docs_d8_journal_decisions_n71", "label": "n\u00b0 71 : calibrage une fois par match", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conforme \u00e0 la source"}, {"id": "docs_d8_journal_decisions_n72", "label": "n\u00b0 72 : variante cheekSquint test\u00e9e en P0", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R\u00e9duire les faux positifs dus \u00e0 la parole"}, {"id": "docs_d8_journal_decisions_n73", "label": "n\u00b0 73 : journal num\u00e9rique P0 sans image ni nom, supprim\u00e9 \u00e0 la cl\u00f4ture", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejouer l'arbitrage avec d'autres valeurs sans refaire les sessions"}, {"id": "docs_d8_journal_decisions_n74", "label": "n\u00b0 74 : d\u00e9finition du faux positif ; N mesurable ; condition accept\u00e9e = jouable", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V\u00e9rit\u00e9 terrain sans vid\u00e9o"}, {"id": "docs_d8_journal_decisions_n75", "label": "n\u00b0 75 : d\u00e9finition de la chauffe excessive", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rendre le crit\u00e8re v\u00e9rifiable dans le journal"}, {"id": "docs_d8_journal_decisions_n76", "label": "n\u00b0 76 : m\u00e9thode de r\u00e9glage : pic soutenu, intervalle de k, groupes, 60 min", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R\u00e9glage faisable au tableur ; \u00e9viter un seuil ajust\u00e9 aux seuls testeurs de r\u00e9glage"}, {"id": "docs_d8_journal_decisions_n77", "label": "n\u00b0 77 : crit\u00e8res de d\u00e9cision Go / Ajustement / Abandon", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La source ne pr\u00e9voyait que \u00ab revoir le seuil \u00bb"}, {"id": "docs_d8_journal_decisions_n78", "label": "n\u00b0 78 : accord oral ; carnation en cat\u00e9gorie grossi\u00e8re, effac\u00e9e", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D\u00e9tecteurs sensibles \u00e0 la carnation ; ne garder que le strict n\u00e9cessaire"}, {"id": "docs_d8_journal_decisions_n79", "label": "n\u00b0 79 : crit\u00e8re G5 : tous les sourires francs d\u00e9tect\u00e9s", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un sourire franc rat\u00e9 d\u00e9truit la confiance autant qu'un faux positif"}, {"id": "docs_d8_journal_decisions_n80", "label": "n\u00b0 80 : d\u00e9tection litigieuse = faux positif", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "En jeu, ce serait une contestation"}, {"id": "docs_d8_journal_decisions_n81", "label": "n\u00b0 81 : performance mesur\u00e9e sans et avec charge vid\u00e9o", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sans appel vid\u00e9o, la mesure est optimiste"}, {"id": "docs_d8_journal_decisions_n82", "label": "n\u00b0 82 : au plus deux cycles d'ajustement avant abandon", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Borner le r\u00e9glage"}, {"id": "docs_d8_journal_decisions_n83", "label": "n\u00b0 83 : k = 0,4", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entre 0,3 et 0,5 le r\u00e9sultat d\u00e9pend peu de k ; 0,4 garde de la marge des deux c\u00f4t\u00e9s"}, {"id": "docs_d8_journal_decisions_n84", "label": "n\u00b0 84 : maintien 500 ms ; arbitre s\u00e9v\u00e8re en dette", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parole : 0,5 faux positif par 20 min \u00e0 400 ms, quasi z\u00e9ro \u00e0 500 ms"}, {"id": "docs_d8_journal_decisions_n85", "label": "n\u00b0 85 : horodatage r\u00e9troactif au d\u00e9but de la s\u00e9rie", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L'instant a un sens physique : le d\u00e9but du sourire"}, {"id": "docs_d8_journal_decisions_n86", "label": "n\u00b0 86 : cadence 15 img/s identique sur les deux appareils", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Des cadences diff\u00e9rentes biaisent \u00ab qui a souri en premier \u00bb"}, {"id": "docs_d8_journal_decisions_n87", "label": "n\u00b0 87 : lissage sur 3 images", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3 images suppriment les faux positifs r\u00e9siduels ; 5 d\u00e9gradent la d\u00e9tection"}, {"id": "docs_d8_journal_decisions_n88", "label": "n\u00b0 88 : fen\u00eatre de simultan\u00e9it\u00e9 100 ms", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erreur de synchro 24 ms + une image : au-del\u00e0 de 100 ms, classement sans erreur"}, {"id": "docs_d8_journal_decisions_n89", "label": "n\u00b0 89 : synchro : 5 allers-retours, plus faible aller-retour", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erreur 95e centile : 41 ms avec 1 aller-retour, 24 ms avec 5"}, {"id": "docs_d8_journal_decisions_n90", "label": "n\u00b0 90 : neutre : 3 s, m\u00e9diane du score liss\u00e9", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erreur sous 2 points sur 100 ; 5 s n'apportent rien"}, {"id": "docs_d8_journal_decisions_n91", "label": "n\u00b0 91 : sourire volontaire : 2 s, maximum du score liss\u00e9", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sous-estimer v multiplie les faux positifs par 20"}, {"id": "docs_d8_journal_decisions_n92", "label": "n\u00b0 92 : d\u00e9lai de visage perdu 1,5 s inchang\u00e9", "file_type": "rationale", "source_file": "docs/D8-journal-decisions.md", "source_